# Integration test configuration
# The full stack (DB, Redis, testnode, backend) must be running before tests execute.

# Backend HTTP API
BACKEND_URL=http://localhost:3000

# Arbitrum Local testnode RPC
RPC_URL=http://localhost:8547
RPC_WSS=ws://localhost:8548

# Nitro prefunded wallet (used for all on-chain interactions)
FUNDED_PK=0xb6b15c8cb491557369f3c7d2c287b053eb229daa9c22138887752191c9520659
FUNDED_ADDRESS=0x3f1Eae7D46d88F08fc2F8ed27FCb2AB183EB2d0E

# L2 chain owner (for precompile admin calls like setWasmExpiryDays)
# In devnode, the funded account becomes chain owner via ArbDebug.becomeChainOwner()
# In testnode, use: 0xdc04c5399f82306ec4b4d654a342f40e2e0620fe39950d967e1e574b32d4dd36
L2_OWNER_PK=0xdc04c5399f82306ec4b4d654a342f40e2e0620fe39950d967e1e574b32d4dd36

# CMA address from the local deployment (must match backend's ARB_LOCAL_CMA_ADDRESS)
CMA_ADDRESS=0x3DF948c956e14175f43670407d5796b95Bb219D8

# Precompile addresses (CacheManager address varies: testnode vs devnode)
CACHE_MANAGER_ADDRESS=0x4A2bA922052bA54e29c5417bC979Daaf7D5Fe4f4
ARB_WASM_ADDRESS=0x0000000000000000000000000000000000000071
ARB_WASM_CACHE_ADDRESS=0x0000000000000000000000000000000000000072
ARB_OWNER_ADDRESS=0x0000000000000000000000000000000000000070

# Database (for direct DB verification)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=scm-db-user
POSTGRES_PASSWORD=scm-db-pwd
POSTGRES_DB=scm_db

# Multipass VM (for time-advance tests)
MULTIPASS_VM_NAME=arbitrum-dev
